{
  "name": "qdb-agent-framework",
  "version": "1.0.0",
  "description": "QDB AI Agent Framework - Multi-agent system for Qatar Development Bank",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:tools": "tsx scripts/seed-tools.ts",
    "seed:policies": "tsx scripts/seed-policies.ts",
    "simulate": "tsx scripts/simulate-workflow.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "docs:html": "node scripts/build-docs-html.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.12.12",
    "openai": "^4.104.0",
    "uuid": "^11.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "marked": "^18.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
